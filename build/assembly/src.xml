<!-- Builds the Kubling source distribution. -->
<assembly>

    <id>src</id>

    <formats>
        <format>zip</format>
    </formats>

    <includeBaseDirectory>false</includeBaseDirectory>

    <fileSets>
        <fileSet>
            <directory>${project.basedir}/..</directory>
            <useDefaultExcludes>true</useDefaultExcludes>
            <outputDirectory>kubling</outputDirectory>
            <excludes>
                <exclude>**/.agents/**</exclude>
                <exclude>**/.codex/**</exclude>
                <exclude>**/.git/**</exclude>
                <exclude>**/.github/modernize/**</exclude>
                <exclude>**/.idea/**</exclude>
                <exclude>**/.mvn/wrapper/maven-wrapper.jar</exclude>
                <exclude>**/target/**</exclude>
                <exclude>**/.settings/**</exclude>
                <exclude>**/*.iml</exclude>
                <exclude>**/*.log</exclude>
                <exclude>**/dependency-check-report.html</exclude>
            </excludes>
        </fileSet>
    </fileSets>

</assembly>
